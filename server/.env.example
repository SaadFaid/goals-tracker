# Copy to `.env` and fill in real secrets.
#
# This file is the template that ships with the repo. The real `.env` holds the
# Supabase connection string and the two JWT secrets and is gitignored - do not
# commit it, not even to a private repo. On a deploy host, keep it outside the
# working tree and point systemd at it:
#   EnvironmentFile=/etc/goals-tracker/secrets.env
# Real .env on this machine: Supabase session-mode pooler on port 5432.
# This project is eu-central-1, so the host is aws-1-eu-central-1, never aws-0.
# The direct db.<ref>.supabase.co host is IPv6-only and unreachable from here.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Use `openssl rand -base64 48` to generate strong secrets.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Comma-separated list of allowed origins (CORS + the refresh cookie).
CLIENT_ORIGIN="http://localhost:5173,https://saadfaid.github.io"
PORT=4000

# Refresh cookie. The site and the API are different sites, so the cookie must
# be SameSite=None; Secure or browsers withhold it on every cross-site fetch and
# the session dies on each reload. Secure needs real HTTPS.
COOKIE_SAME_SITE="none"
COOKIE_SECURE="true"
