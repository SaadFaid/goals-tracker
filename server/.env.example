# Copy to `.env` and fill in real secrets.
# Set up Postgres first:  docker compose up -d   (see docker-compose.yml)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/august_goals"

# Use `openssl rand -base64 48` to generate strong secrets.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Origin of the Vite dev server (used for the refresh-token cookie + CORS).
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
